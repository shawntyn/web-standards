{
  "id": "analytics",
  "type": "Stack",
  "props": {
    "gap": "md"
  },
  "children": [
    {
      "id": "analytics-title",
      "type": "h1",
      "props": {
        "text": "渠道订单"
      }
    },
    {
      "id": "analytics-intro",
      "type": "p",
      "props": {
        "text": "每行一个来源渠道，订单数保留零值。"
      }
    },
    {
      "id": "channels-table",
      "type": "ContentTable",
      "props": {
        "caption": "渠道订单明细",
        "columns": ["来源渠道", "订单数"],
        "rows": []
      }
    },
    {
      "id": "analytics-links",
      "type": "Grid",
      "props": {
        "columns": 2
      },
      "children": [
        {
          "id": "analytics-commerce",
          "type": "LinkButton",
          "props": {
            "label": "查看订单数据",
            "href": "/analytics/commerce"
          }
        },
        {
          "id": "analytics-empty",
          "type": "LinkButton",
          "props": {
            "label": "查看空数据",
            "href": "/analytics/empty"
          }
        }
      ]
    }
  ]
}
